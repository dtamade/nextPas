    {
      "name": "ShiftLeft",
      "signature": "shift",
      "scalar_op": "shl",
      "doc": "Logical shift left (narrow integer)",
      "scalar_body_by_type": {
        "I16x32": [
          "if (count < 0) or (count >= 16) then",
          "  for i := 0 to 31 do",
          "    Result.{field}[i] := 0",
          "else",
          "  for i := 0 to 31 do",
          "    Result.{field}[i] := a.{field}[i] shl count;"
        ]
      },
      "applies_to": ["I16x8", "I16x32", "U16x8", "U64x4", "U64x8"]
    },
    {
      "name": "ShiftRight",
      "signature": "shift",
      "scalar_op": "shr",
      "doc": "Logical shift right (narrow integer)",
      "scalar_body_by_type": {
        "I16x32": [
          "if (count < 0) or (count >= 16) then",
          "  for i := 0 to 31 do",
          "    Result.{field}[i] := 0",
          "else",
          "  for i := 0 to 31 do",
          "    Result.{field}[i] := Int16(UInt16(a.{field}[i]) shr count);"
        ]
      },
      "applies_to": ["I16x8", "I16x32", "U16x8", "U64x4", "U64x8"]
    },
    {
      "name": "ShiftRightArith",
      "signature": "shift",
      "scalar_op": "custom",
      "scalar_body": "Result.{field}[i] := SarLongInt(a.{field}[i], count)",
      "doc": "Arithmetic shift right (narrow integer)",
      "scalar_body_by_type": {
        "I16x32": [
          "if count < 0 then",
          "  for i := 0 to 31 do",
          "    Result.{field}[i] := a.{field}[i]",
          "else if count >= 16 then",
          "  for i := 0 to 31 do",
          "    if a.{field}[i] < 0 then",
          "      Result.{field}[i] := -1",
          "    else",
          "      Result.{field}[i] := 0",
          "else",
          "  for i := 0 to 31 do",
          "    Result.{field}[i] := Int16(SarLongint(a.{field}[i], count));"
        ]
      },
      "applies_to": ["I16x8", "I16x32"]
    }
