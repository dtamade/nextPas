{
  "_comment": "SIMD pointer/text helper definitions that are dispatch slots but not vector lane operations",
  "category": "text",
  "operations": [
    {
      "name": "MemEqual",
      "signature": "pointer_ptr_len_longbool",
      "scalar_op": "custom",
      "scalar_name_pattern": "{op}_Scalar",
      "doc": "Compare two byte ranges for equality",
      "scalar_vars": [
        "pa, pb: PByte",
        "pqa, pqb: PQWord",
        "i, qwordCount, remaining: SizeUInt"
      ],
      "scalar_body": [
        "{$PUSH}{$Q-}{$R-}",
        "if len = 0 then",
        "begin",
        "  Result := True;",
        "  Exit;",
        "end;",
        "",
        "if (a = nil) or (b = nil) then",
        "begin",
        "  Result := (a = b);",
        "  Exit;",
        "end;",
        "",
        "pa := PByte(a);",
        "pb := PByte(b);",
        "",
        "qwordCount := len div 8;",
        "if qwordCount > 0 then",
        "begin",
        "  pqa := PQWord(pa);",
        "  pqb := PQWord(pb);",
        "  for i := 0 to qwordCount - 1 do",
        "  begin",
        "    if pqa[i] <> pqb[i] then",
        "    begin",
        "      Result := False;",
        "      Exit;",
        "    end;",
        "  end;",
        "  pa := pa + qwordCount * 8;",
        "  pb := pb + qwordCount * 8;",
        "end;",
        "",
        "remaining := len mod 8;",
        "if remaining > 0 then",
        "  for i := 0 to remaining - 1 do",
        "  begin",
        "    if pa[i] <> pb[i] then",
        "    begin",
        "      Result := False;",
        "      Exit;",
        "    end;",
        "  end;",
        "",
        "Result := True;",
        "{$POP}"
      ],
      "applies_to": []
    },
    {
      "name": "AsciiIEqual",
      "signature": "pointer_ptr_len_bool",
      "scalar_op": "custom",
      "scalar_name_pattern": "{op}_Scalar",
      "doc": "Compare ASCII byte ranges case-insensitively",
      "scalar_vars": [
        "pa, pb: PByte",
        "i: SizeUInt",
        "ca, cb: Byte"
      ],
      "scalar_body": [
        "if len = 0 then",
        "begin",
        "  Result := True;",
        "  Exit;",
        "end;",
        "",
        "if (a = nil) or (b = nil) then",
        "begin",
        "  Result := (a = b);",
        "  Exit;",
        "end;",
        "",
        "pa := PByte(a);",
        "pb := PByte(b);",
        "",
        "for i := 0 to len - 1 do",
        "begin",
        "  ca := pa[i];",
        "  cb := pb[i];",
        "",
        "  if (ca >= Ord('A')) and (ca <= Ord('Z')) then",
        "    ca := ca + 32;",
        "  if (cb >= Ord('A')) and (cb <= Ord('Z')) then",
        "    cb := cb + 32;",
        "",
        "  if ca <> cb then",
        "  begin",
        "    Result := False;",
        "    Exit;",
        "  end;",
        "end;",
        "",
        "Result := True;"
      ],
      "applies_to": []
    },
    {
      "name": "ToLowerAscii",
      "signature": "pointer_len_void",
      "scalar_op": "custom",
      "scalar_name_pattern": "{op}_Scalar",
      "doc": "Convert ASCII bytes to lowercase in place",
      "scalar_vars": [
        "pb: PByte"
      ],
      "scalar_body": [
        "if (len = 0) or (p = nil) then",
        "  Exit;",
        "",
        "pb := PByte(p);",
        "",
        "for i := 0 to len - 1 do",
        "begin",
        "  if (pb[i] >= Ord('A')) and (pb[i] <= Ord('Z')) then",
        "    pb[i] := pb[i] + 32;",
        "end;"
      ],
      "applies_to": []
    },
    {
      "name": "ToUpperAscii",
      "signature": "pointer_len_void",
      "scalar_op": "custom",
      "scalar_name_pattern": "{op}_Scalar",
      "doc": "Convert ASCII bytes to uppercase in place",
      "scalar_vars": [
        "pb: PByte"
      ],
      "scalar_body": [
        "if (len = 0) or (p = nil) then",
        "  Exit;",
        "",
        "pb := PByte(p);",
        "",
        "for i := 0 to len - 1 do",
        "begin",
        "  if (pb[i] >= Ord('a')) and (pb[i] <= Ord('z')) then",
        "    pb[i] := pb[i] - 32;",
        "end;"
      ],
      "applies_to": []
    },
    {
      "name": "Utf8Validate",
      "signature": "pointer_len_bool",
      "scalar_op": "custom",
      "scalar_name_pattern": "{op}_Scalar",
      "doc": "Validate UTF-8 byte sequence",
      "scalar_vars": [
        "pb: PByte",
        "i: SizeUInt",
        "b, b2: Byte",
        "seqLen: Integer",
        "j: Integer"
      ],
      "scalar_body": [
        "Result := True;",
        "",
        "if len = 0 then",
        "  Exit(True);",
        "if p = nil then",
        "  Exit(False);",
        "",
        "pb := PByte(p);",
        "i := 0;",
        "",
        "while i < len do",
        "begin",
        "  b := pb[i];",
        "",
        "  if (b and $80) = 0 then",
        "  begin",
        "    Inc(i);",
        "    Continue;",
        "  end;",
        "",
        "  if (b >= $C2) and (b <= $DF) then",
        "    seqLen := 2",
        "  else if (b and $F0) = $E0 then",
        "    seqLen := 3",
        "  else if (b >= $F0) and (b <= $F4) then",
        "    seqLen := 4",
        "  else",
        "  begin",
        "    Result := False;",
        "    Exit;",
        "  end;",
        "",
        "  if i + SizeUInt(seqLen) > len then",
        "  begin",
        "    Result := False;",
        "    Exit;",
        "  end;",
        "",
        "  for j := 1 to seqLen - 1 do",
        "  begin",
        "    if (pb[i + SizeUInt(j)] and $C0) <> $80 then",
        "    begin",
        "      Result := False;",
        "      Exit;",
        "    end;",
        "  end;",
        "",
        "  if seqLen = 3 then",
        "  begin",
        "    b2 := pb[i + 1];",
        "    if (b = $E0) and (b2 < $A0) then",
        "    begin",
        "      Result := False;",
        "      Exit;",
        "    end;",
        "    if (b = $ED) and (b2 >= $A0) then",
        "    begin",
        "      Result := False;",
        "      Exit;",
        "    end;",
        "  end",
        "  else if seqLen = 4 then",
        "  begin",
        "    b2 := pb[i + 1];",
        "    if (b = $F0) and (b2 < $90) then",
        "    begin",
        "      Result := False;",
        "      Exit;",
        "    end;",
        "    if (b = $F4) and (b2 >= $90) then",
        "    begin",
        "      Result := False;",
        "      Exit;",
        "    end;",
        "  end;",
        "",
        "  Inc(i, seqLen);",
        "end;"
      ],
      "applies_to": []
    }
  ]
}
