    {
      "name": "AndNot",
      "signature": "binary",
      "scalar_op": "custom",
      "scalar_body": "Result.{field}[i] := (not a.{field}[i]) and b.{field}[i]",
      "doc": "Bitwise AND-NOT: (~a) & b",
      "applies_to": [
        "I16x8", "I8x16",
