      AssertVecI16x32Equal('AndNotI16x32 parity: ' + NonX86BackendName(LBackend), LVecByScalar, LVecByBackend);

      for LIndex := 0 to High(LShiftCounts) do
      begin
        LShiftCount := LShiftCounts[LIndex];

