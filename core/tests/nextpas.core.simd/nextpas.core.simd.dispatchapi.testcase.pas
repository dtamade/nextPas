  LU64ByBackend, LU64ByScalar: TVecU64x8;
  LU8ByBackend, LU8ByScalar: TVecU8x64;
  LMask16ByBackend, LMask16ByScalar: TMask16;
  LMask8ByBackend, LMask8ByScalar: TMask8;
  LMask64ByBackend, LMask64ByScalar: TMask64;
