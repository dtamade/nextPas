  end;

  LMaskDispatch := LDispatch^.CoreVectors.CmpGtU8x64(LA, LB);
  LMaskScalar := ScalarCmpGtU8x64(LA, LB);
  CheckEqual(QWord(LMaskScalar), QWord(LMaskDispatch), 'Dispatch/Scalar CmpGtU8x64 parity');
end;

