  end;

  if LCheckedBackends = 0 then
    AssertTrue('No non-x86 asm backend registered on this host (allowed)', True);
end;

procedure TTestCase_NonX86BackendParity.Test_NativeWideInsertHelperParity_WithVectorAsm_IfAvailable;
