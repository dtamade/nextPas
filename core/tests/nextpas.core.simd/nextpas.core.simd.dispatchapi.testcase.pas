  procedure AssertVecI32x8Equal(const aOp, aBackendName: string; const aExpected, aActual: TVecI32x8);
  var
    LLane: Integer;
  begin
    for LLane := 0 to 7 do
      AssertEquals(aOp + ' parity lane ' + IntToStr(LLane) + ': ' + aBackendName,
        aExpected.i[LLane], aActual.i[LLane]);
