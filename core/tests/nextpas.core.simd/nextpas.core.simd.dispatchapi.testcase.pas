var
  LIndex: Integer;

  LI32x16A, LI32x16B, LI32x16Facade, LI32x16Scalar, LI32x16Inserted: TVecI32x16;
  LI32x4A, LI32x4B, LI32x4Facade, LI32x4Scalar, LI32x4Mask: TVecI32x4;
