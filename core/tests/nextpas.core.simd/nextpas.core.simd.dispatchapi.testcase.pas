procedure TTestCase_DispatchAPI.Test_NonX86_DispatchTable_WiringChecklist;
var
  LBackends: array[0..1] of TSimdBackend;
  LBackend: TSimdBackend;
  LTable: TSimdDispatchTable;
  LRegisteredCount: Integer;
begin
  LBackends[0] := sbNEON;
