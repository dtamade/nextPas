  LBackends[1] := sbRISCVV;
  LCheckedBackends := 0;

  LF32x4Base.f[0] := 1.25;
  LF32x4Base.f[1] := -2.5;
  LF32x4Base.f[2] := 3.75;
  LF32x4Base.f[3] := -4.125;

  LF64x2Base.d[0] := 123.5;
  LF64x2Base.d[1] := -987.25;

