    LLane: Integer;
  begin
    for LLane := 0 to 3 do
      AssertEquals(aOp + ' parity lane ' + IntToStr(LLane) + ': ' + aBackendName,
        aExpected.d[LLane], aActual.d[LLane], aEps);
