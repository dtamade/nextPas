  AssertNeonReusesScalarOtherwiseNative('SqrtF64x8',
    Pointer(LScalarTable.SqrtF64x8), Pointer(LBackendTable.SqrtF64x8));
  AssertNativeSlotNotScalar(DispatchApiBackendName(LBackend), 'FmaF64x8',
