        LScalarTable.ExtractF32x8(LF32x8Base, LExtractIndex), VecF32x8Extract(LF32x8Base, LExtractIndex), 1e-6);
    end;

    for LIndex := 0 to 3 do
    begin
      case LIndex of
        0: LExtractIndex := -99;
        1: LExtractIndex := 0;
        2: LExtractIndex := 15;
