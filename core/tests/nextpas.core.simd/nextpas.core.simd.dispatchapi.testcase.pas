  LZero3.f[0] := 0.0;
  LZero3.f[1] := 0.0;
  LZero3.f[2] := 0.0;
  LZero3.f[3] := 17.0;

  LTiny3.f[0] := 1.0e-20;
  LTiny3.f[1] := -2.0e-20;
  LTiny3.f[2] := 3.0e-20;
  LTiny3.f[3] := 29.0;

  LZero4.f[0] := 0.0;
  LZero4.f[1] := 0.0;
  LZero4.f[2] := 0.0;
  LZero4.f[3] := 0.0;

  LTiny4.f[0] := 1.0e-20;
  LTiny4.f[1] := -2.0e-20;
