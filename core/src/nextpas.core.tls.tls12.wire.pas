unit nextpas.core.tls.tls12.wire;

{$mode objfpc}{$H+}{$J-}

interface

uses
  SysUtils;

const
  TLS12_VERSION_MAJOR = 3;
  TLS12_VERSION_MINOR = 3;

  TLS12_CONTENT_CHANGE_CIPHER_SPEC = 20;
  TLS12_CONTENT_ALERT = 21;
  TLS12_CONTENT_HANDSHAKE = 22;
  TLS12_CONTENT_APPLICATION_DATA = 23;

  TLS12_HANDSHAKE_CLIENT_HELLO = 1;
  TLS12_HANDSHAKE_SERVER_HELLO = 2;
  TLS12_HANDSHAKE_CERTIFICATE = 11;
  TLS12_HANDSHAKE_SERVER_KEY_EXCHANGE = 12;
  TLS12_HANDSHAKE_CERTIFICATE_REQUEST = 13;
  TLS12_HANDSHAKE_SERVER_HELLO_DONE = 14;
  TLS12_HANDSHAKE_CERTIFICATE_VERIFY = 15;
  TLS12_HANDSHAKE_CLIENT_KEY_EXCHANGE = 16;
  TLS12_HANDSHAKE_FINISHED = 20;

  TLS12_EXT_SERVER_NAME = 0;
  TLS12_EXT_EC_POINT_FORMATS = 11;
  TLS12_EXT_SUPPORTED_GROUPS = 10;
  TLS12_EXT_SIGNATURE_ALGORITHMS = 13;
  TLS12_EXT_ALPN = 16;
  TLS12_EXT_EXTENDED_MASTER_SECRET = 23;
  TLS12_EXT_SESSION_TICKET = 35;
  TLS12_EXT_RENEGOTIATION_INFO = $FF01;

  TLS12_HANDSHAKE_NEW_SESSION_TICKET = 4;

  TLS12_CIPHER_ECDHE_RSA_WITH_AES_128_GCM_SHA256 = $C02F;
  TLS12_CIPHER_ECDHE_RSA_WITH_AES_256_GCM_SHA384 = $C030;
  TLS12_CIPHER_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 = $C02B;
  TLS12_CIPHER_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 = $C02C;
  TLS12_CIPHER_ECDHE_RSA_WITH_AES_128_CBC_SHA256 = $C027;
  TLS12_CIPHER_ECDHE_RSA_WITH_AES_256_CBC_SHA384 = $C028;
  TLS12_CIPHER_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 = $CCA8;
  TLS12_CIPHER_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 = $CCA9;

  TLS12_GROUP_X25519 = 29;
  TLS12_GROUP_SECP256R1 = 23;

  TLS12_SIG_RSA_PKCS1_SHA256 = $0401;
  TLS12_SIG_RSA_PKCS1_SHA384 = $0501;
  TLS12_SIG_ECDSA_SECP256R1_SHA256 = $0403;

  TLS12_EC_POINT_FORMAT_UNCOMPRESSED = 0;

  TLS12_ALERT_LEVEL_WARNING = 1;
  TLS12_ALERT_LEVEL_FATAL = 2;

  TLS12_ALERT_CLOSE_NOTIFY = 0;
  TLS12_ALERT_UNEXPECTED_MESSAGE = 10;
  TLS12_ALERT_BAD_RECORD_MAC = 20;
  TLS12_ALERT_HANDSHAKE_FAILURE = 40;
  TLS12_ALERT_BAD_CERTIFICATE = 42;
  TLS12_ALERT_CERTIFICATE_EXPIRED = 45;
  TLS12_ALERT_CERTIFICATE_UNKNOWN = 46;
  TLS12_ALERT_ILLEGAL_PARAMETER = 47;
  TLS12_ALERT_UNKNOWN_CA = 48;
  TLS12_ALERT_DECODE_ERROR = 50;
  TLS12_ALERT_DECRYPT_ERROR = 51;
  TLS12_ALERT_PROTOCOL_VERSION = 70;
  TLS12_ALERT_INTERNAL_ERROR = 80;
  TLS12_ALERT_NO_RENEGOTIATION = 100;

  TLS12_RECORD_MAX_LENGTH = 16384;

function TLS12BuildRecordHeader(AContentType: Byte; ALength: Integer): TBytes;
function TLS12BuildHandshakeHeader(AHandshakeType: Byte; ABodyLength: Integer): TBytes;

implementation

function TLS12BuildRecordHeader(AContentType: Byte; ALength: Integer): TBytes;
begin
  SetLength(Result, 5);
  Result[0] := AContentType;
  Result[1] := TLS12_VERSION_MAJOR;
  Result[2] := TLS12_VERSION_MINOR;
  Result[3] := Byte(ALength shr 8);
  Result[4] := Byte(ALength);
end;

function TLS12BuildHandshakeHeader(AHandshakeType: Byte; ABodyLength: Integer): TBytes;
begin
  SetLength(Result, 4);
  Result[0] := AHandshakeType;
  Result[1] := Byte(ABodyLength shr 16);
  Result[2] := Byte(ABodyLength shr 8);
  Result[3] := Byte(ABodyLength);
end;

end.
