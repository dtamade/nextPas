function ScalarShiftLeftI32x4(const a: TVecI32x4; count: Integer): TVecI32x4;
var i: Integer;
begin
  if count <= 0 then begin Result := a; Exit; end;
  if count >= 32 then
  begin
    // 超出范围时返回零（与 SIMD 行为一致）
    for i := 0 to 3 do
      Result.i[i] := 0;
  end
  else
  begin
    for i := 0 to 3 do
      Result.i[i] := a.i[i] shl count;
  end;
end;

