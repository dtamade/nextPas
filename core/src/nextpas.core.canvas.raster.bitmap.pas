{**
 * nextpas.core.canvas.raster.bitmap - bitmap blit three-way nearest/linear/cubic
 *}
unit nextpas.core.canvas.raster.bitmap;
{$I nextpas.core.settings.inc}
{$modeswitch advancedrecords}
interface
uses nextpas.core.graphics.base, nextpas.core.canvas.base, nextpas.core.image.base;
procedure BitmapBlit(var ADst: TBitmap; const ASrc: TBitmap; const ASrcRect, ADstRect: TRect; AQuality: TFilterQuality; const AClipR: TRect; AHasClip: Boolean);
implementation
uses nextpas.core.base, nextpas.core.errors, nextpas.core.graphics.errors, nextpas.core.math, nextpas.core.bytes.ops;
procedure BitmapBlit(var ADst: TBitmap; const ASrc: TBitmap; const ASrcRect, ADstRect: TRect; AQuality: TFilterQuality; const AClipR: TRect; AHasClip: Boolean);
var SW,SH,DW,DH,DX,DY,Y,X,SY,SX,DstY,ClipX0,ClipX1,IX0,IY0,IX1,IY1,c4,wyI,wxI,w00i,w10i,w01i,w11i,DstStride,SrcStride,wxInc,wyInc,fxFixedStart,fyFixedStart,fxFixed,fyFixed,ky,kx,sxK,syK: Integer;
  SX0f,SY0f,ScaleX,ScaleY,FX,FY,fxF,fyF,rAcc,gAcc,bAcc,aAcc: Single;
  SrcRow,DstRow,SrcRow0,SrcRow1: PByte; DstBase,SrcBase: PByte; C00,C10,C01,C11: LongWord; R,G,B,A: Byte; wxW,wyW: array[0..3] of Single; sc: LongWord;
  CubicRows: array[0..3] of PByte; ChunkCubic: array[0..3] of LongWord;
  function CubicW(AT: Single): Single; inline; var Av: Single; begin Av:=Abs(AT); if Av<1 then Result:=1.5*Av*Av*Av-2.5*Av*Av+1 else if Av<2 then Result:=-0.5*Av*Av*Av+2.5*Av*Av-4*Av+2 else Result:=0; end;
begin SW:=Trunc(ASrcRect.W); SH:=Trunc(ASrcRect.H); DW:=Trunc(ADstRect.W); DH:=Trunc(ADstRect.H); if (SW<=0) or (SH<=0) or (DW<=0) or (DH<=0) then Exit; DX:=Trunc(ADstRect.X); DY:=Trunc(ADstRect.Y); SX0f:=ASrcRect.X; SY0f:=ASrcRect.Y; ScaleX:=ASrcRect.W/ADstRect.W; ScaleY:=ASrcRect.H/ADstRect.H; if AHasClip and AClipR.IsEmpty then Exit; ADst.EnsureUnique; DstStride:=ADst.Stride; SrcStride:=ASrc.Stride; if (not ADst.IsEmpty) and (ADst.Height>0) then DstBase:=ADst.UnsafeMutableRowPtr(0) else DstBase:=nil; if not ASrc.IsEmpty then SrcBase:=ASrc.ConstRowPtr(0) else SrcBase:=nil; if (SW=DW) and (SH=DH) and (AQuality=fqNearest) then begin if (Trunc(SX0f)=SX0f) and (Trunc(SY0f)=SY0f) then begin for Y:=0 to DH-1 do begin DstY:=DY+Y; if (DstY<0) or (DstY>=ADst.Height) then Continue; if AHasClip then begin if DstY<Trunc(AClipR.Y) then Continue; if DstY>=Trunc(AClipR.Y+AClipR.H) then Continue; end; SY:=Trunc(SY0f)+Y; if (SY<0) or (SY>=ASrc.Height) then Continue; ClipX0:=0; ClipX1:=DW; if DX<0 then ClipX0:=-DX; if DX+ClipX1>ADst.Width then ClipX1:=ADst.Width-DX; if ClipX1<=ClipX0 then Continue; if Trunc(SX0f)+ClipX0<0 then ClipX0:=-Trunc(SX0f); if Trunc(SX0f)+ClipX1>ASrc.Width then ClipX1:=ASrc.Width-Trunc(SX0f); if AHasClip then begin if DX+ClipX1<=Trunc(AClipR.X) then Continue; if DX+ClipX0>=Trunc(AClipR.X+AClipR.W) then Continue; if DX+ClipX0<Trunc(AClipR.X) then ClipX0:=Trunc(AClipR.X)-DX; if DX+ClipX1>Trunc(AClipR.X+AClipR.W) then ClipX1:=Trunc(AClipR.X+AClipR.W)-DX; end; if ClipX1<=ClipX0 then Continue; SrcRow:=SrcBase+SY*SrcStride+Trunc(SX0f)*4+ClipX0*4; DstRow:=DstBase+DstY*DstStride+DX*4+ClipX0*4; BytesCopy(DstRow,SrcRow,NativeUInt((ClipX1-ClipX0)*4)); end; Exit; end; end; case AQuality of fqNearest: begin for Y:=0 to DH-1 do begin DstY:=DY+Y; if (DstY<0) or (DstY>=ADst.Height) then Continue; if AHasClip then begin if DstY<Trunc(AClipR.Y) then Continue; if DstY>=Trunc(AClipR.Y+AClipR.H) then Continue; end; FY:=SY0f+Y*ScaleY; SY:=Trunc(FY); if SY<0 then SY:=0 else if SY>=ASrc.Height then SY:=ASrc.Height-1; SrcRow:=SrcBase+SY*SrcStride; DstRow:=DstBase+DstY*DstStride; ClipX0:=0; ClipX1:=DW; if DX<0 then ClipX0:=-DX; if DX+ClipX1>ADst.Width then ClipX1:=ADst.Width-DX; if AHasClip then begin if DX+ClipX1<=Trunc(AClipR.X) then Continue; if DX+ClipX0>=Trunc(AClipR.X+AClipR.W) then Continue; if DX+ClipX0<Trunc(AClipR.X) then ClipX0:=Trunc(AClipR.X)-DX; if DX+ClipX1>Trunc(AClipR.X+AClipR.W) then ClipX1:=Trunc(AClipR.X+AClipR.W)-DX; end; if ClipX1<=ClipX0 then Continue; for X:=ClipX0 to ClipX1-1 do begin FX:=SX0f+X*ScaleX; SX:=Trunc(FX); if (SX<0) or (SX>=ASrc.Width) then Continue; PLongWord(DstRow)[DX+X]:=PLongWord(SrcRow)[SX]; end; end; end; fqLinear: begin wxInc:=Round(ScaleX*256); wyInc:=Round(ScaleY*256); ClipX0:=0; ClipX1:=DW; if DX<0 then ClipX0:=-DX; if DX+ClipX1>ADst.Width then ClipX1:=ADst.Width-DX; if Trunc(SX0f)+ClipX0<0 then ClipX0:=-Trunc(SX0f); if Trunc(SX0f)+ClipX1>ASrc.Width then ClipX1:=ASrc.Width-Trunc(SX0f); if AHasClip then begin if DX+ClipX1<=Trunc(AClipR.X) then Exit; if DX+ClipX0>=Trunc(AClipR.X+AClipR.W) then Exit; if DX+ClipX0<Trunc(AClipR.X) then ClipX0:=Trunc(AClipR.X)-DX; if DX+ClipX1>Trunc(AClipR.X+AClipR.W) then ClipX1:=Trunc(AClipR.X+AClipR.W)-DX; end; if ClipX1<=ClipX0 then Exit; fxFixedStart:=Round((SX0f+(ClipX0+0.5)*ScaleX-0.5)*256); fyFixedStart:=Round((SY0f+0.5*ScaleY-0.5)*256); fyFixed:=fyFixedStart; for Y:=0 to DH-1 do begin DstY:=DY+Y; if (DstY<0) or (DstY>=ADst.Height) then begin Inc(fyFixed,wyInc); Continue; end; if AHasClip then begin if DstY<Trunc(AClipR.Y) then begin Inc(fyFixed,wyInc); Continue; end; if DstY>=Trunc(AClipR.Y+AClipR.H) then begin Inc(fyFixed,wyInc); Continue; end; end; if fyFixed>=0 then begin IY0:=fyFixed div 256; wyI:=fyFixed and 255; end else begin IY0:=(fyFixed-255) div 256; wyI:=fyFixed-IY0*256; end; if ASrc.Height=1 then begin IY0:=0; wyI:=0; end else begin if IY0<0 then begin IY0:=0; wyI:=0; end; if IY0>=ASrc.Height-1 then begin IY0:=ASrc.Height-2; wyI:=256; end; end; IY1:=IY0+1; if IY1>=ASrc.Height then IY1:=IY0; SrcRow0:=SrcBase+IY0*SrcStride; SrcRow1:=SrcBase+IY1*SrcStride; DstRow:=DstBase+DstY*DstStride; if wyI<0 then wyI:=0 else if wyI>256 then wyI:=256; fxFixed:=fxFixedStart; X:=ClipX0; while X+3<ClipX1 do begin for c4:=0 to 3 do begin if fxFixed>=0 then begin IX0:=fxFixed div 256; wxI:=fxFixed and 255; end else begin IX0:=(fxFixed-255) div 256; wxI:=fxFixed-IX0*256; end; if ASrc.Width=1 then begin IX0:=0; wxI:=0; end else begin if IX0<0 then begin IX0:=0; wxI:=0; end; if IX0>=ASrc.Width-1 then begin IX0:=ASrc.Width-2; wxI:=256; end; end; IX1:=IX0+1; if IX1>=ASrc.Width then IX1:=IX0; if wxI<0 then wxI:=0 else if wxI>256 then wxI:=256; w00i:=(256-wxI)*(256-wyI); w10i:=wxI*(256-wyI); w01i:=(256-wxI)*wyI; w11i:=wxI*wyI; C00:=PLongWord(SrcRow0)[IX0]; C10:=PLongWord(SrcRow0)[IX1]; C01:=PLongWord(SrcRow1)[IX0]; C11:=PLongWord(SrcRow1)[IX1]; R:=Byte((Byte(C00)*w00i+Byte(C10)*w10i+Byte(C01)*w01i+Byte(C11)*w11i+32768) shr 16); G:=Byte((Byte(C00 shr 8)*w00i+Byte(C10 shr 8)*w10i+Byte(C01 shr 8)*w01i+Byte(C11 shr 8)*w11i+32768) shr 16); B:=Byte((Byte(C00 shr 16)*w00i+Byte(C10 shr 16)*w10i+Byte(C01 shr 16)*w11i+32768) shr 16); A:=Byte((Byte(C00 shr 24)*w00i+Byte(C10 shr 24)*w10i+Byte(C01 shr 24)*w11i+32768) shr 16); PLongWord(DstRow)[DX+X+c4]:=LongWord(R) or (LongWord(G) shl 8) or (LongWord(B) shl 16) or (LongWord(A) shl 24); Inc(fxFixed,wxInc); end; X:=X+4; end; while X<ClipX1 do begin if fxFixed>=0 then begin IX0:=fxFixed div 256; wxI:=fxFixed and 255; end else begin IX0:=(fxFixed-255) div 256; wxI:=fxFixed-IX0*256; end; if ASrc.Width=1 then begin IX0:=0; wxI:=0; end else begin if IX0<0 then begin IX0:=0; wxI:=0; end; if IX0>=ASrc.Width-1 then begin IX0:=ASrc.Width-2; wxI:=256; end; end; IX1:=IX0+1; if IX1>=ASrc.Width then IX1:=IX0; if wxI<0 then wxI:=0 else if wxI>256 then wxI:=256; w00i:=(256-wxI)*(256-wyI); w10i:=wxI*(256-wyI); w01i:=(256-wxI)*wyI; w11i:=wxI*wyI; C00:=PLongWord(SrcRow0)[IX0]; C10:=PLongWord(SrcRow0)[IX1]; C01:=PLongWord(SrcRow1)[IX0]; C11:=PLongWord(SrcRow1)[IX1]; R:=Byte((Byte(C00)*w00i+Byte(C10)*w10i+Byte(C01)*w01i+Byte(C11)*w11i+32768) shr 16); G:=Byte((Byte(C00 shr 8)*w00i+Byte(C10 shr 8)*w10i+Byte(C01 shr 8)*w01i+Byte(C11 shr 8)*w11i+32768) shr 16); B:=Byte((Byte(C00 shr 16)*w00i+Byte(C10 shr 16)*w10i+Byte(C01 shr 16)*w11i+32768) shr 16); A:=Byte((Byte(C00 shr 24)*w00i+Byte(C10 shr 24)*w10i+Byte(C01 shr 24)*w11i+32768) shr 16); PLongWord(DstRow)[DX+X]:=LongWord(R) or (LongWord(G) shl 8) or (LongWord(B) shl 16) or (LongWord(A) shl 24); Inc(fxFixed,wxInc); Inc(X); end; Inc(fyFixed,wyInc); end; end; fqCubic: begin wxInc:=Round(ScaleX*256); wyInc:=Round(ScaleY*256); ClipX0:=0; ClipX1:=DW; if DX<0 then ClipX0:=-DX; if DX+ClipX1>ADst.Width then ClipX1:=ADst.Width-DX; if Trunc(SX0f)+ClipX0<0 then ClipX0:=-Trunc(SX0f); if Trunc(SX0f)+ClipX1>ASrc.Width then ClipX1:=ASrc.Width-Trunc(SX0f); if AHasClip then begin if DX+ClipX1<=Trunc(AClipR.X) then Exit; if DX+ClipX0>=Trunc(AClipR.X+AClipR.W) then Exit; if DX+ClipX0<Trunc(AClipR.X) then ClipX0:=Trunc(AClipR.X)-DX; if DX+ClipX1>Trunc(AClipR.X+AClipR.W) then ClipX1:=Trunc(AClipR.X+AClipR.W)-DX; end; if ClipX1<=ClipX0 then Exit; fxFixedStart:=Round((SX0f+(ClipX0+0.5)*ScaleX-0.5)*256); fyFixedStart:=Round((SY0f+0.5*ScaleY-0.5)*256); fyFixed:=fyFixedStart; for Y:=0 to DH-1 do begin DstY:=DY+Y; if (DstY<0) or (DstY>=ADst.Height) then begin Inc(fyFixed,wyInc); Continue; end; if AHasClip then begin if DstY<Trunc(AClipR.Y) then begin Inc(fyFixed,wyInc); Continue; end; if DstY>=Trunc(AClipR.Y+AClipR.H) then begin Inc(fyFixed,wyInc); Continue; end; end; if fyFixed>=0 then begin IY0:=fyFixed div 256; wyI:=fyFixed and 255; end else begin IY0:=(fyFixed-255) div 256; wyI:=fyFixed-IY0*256; end; DstRow:=DstBase+DstY*DstStride; for ky:=0 to 3 do begin syK:=IY0+ky-1; if syK<0 then syK:=0 else if syK>=ASrc.Height then syK:=ASrc.Height-1; CubicRows[ky]:=SrcBase+syK*SrcStride; end; fyF:=wyI/256; wyW[0]:=CubicW(1+fyF); wyW[1]:=CubicW(fyF); wyW[2]:=CubicW(1-fyF); wyW[3]:=CubicW(2-fyF); fxFixed:=fxFixedStart; X:=ClipX0; while X+3<ClipX1 do begin for c4:=0 to 3 do begin if fxFixed>=0 then begin IX0:=fxFixed div 256; wxI:=fxFixed and 255; end else begin IX0:=(fxFixed-255) div 256; wxI:=fxFixed-IX0*256; end; fxF:=wxI/256; wxW[0]:=CubicW(1+fxF); wxW[1]:=CubicW(fxF); wxW[2]:=CubicW(1-fxF); wxW[3]:=CubicW(2-fxF); rAcc:=0; gAcc:=0; bAcc:=0; aAcc:=0; for ky:=0 to 3 do begin SrcRow:=CubicRows[ky]; for kx:=0 to 3 do begin sxK:=IX0+kx-1; if sxK<0 then sxK:=0 else if sxK>=ASrc.Width then sxK:=ASrc.Width-1; sc:=PLongWord(SrcRow)[sxK]; rAcc:=rAcc+Byte(sc)*wxW[kx]*wyW[ky]; gAcc:=gAcc+Byte(sc shr 8)*wxW[kx]*wyW[ky]; bAcc:=bAcc+Byte(sc shr 16)*wxW[kx]*wyW[ky]; aAcc:=aAcc+Byte(sc shr 24)*wxW[kx]*wyW[ky]; end; end; if rAcc<0 then rAcc:=0 else if rAcc>255 then rAcc:=255; if gAcc<0 then gAcc:=0 else if gAcc>255 then gAcc:=255; if bAcc<0 then bAcc:=0 else if bAcc>255 then bAcc:=255; if aAcc<0 then aAcc:=0 else if aAcc>255 then aAcc:=255; R:=Byte(Round(rAcc)); G:=Byte(Round(gAcc)); B:=Byte(Round(bAcc)); A:=Byte(Round(aAcc)); ChunkCubic[c4]:=LongWord(R) or (LongWord(G) shl 8) or (LongWord(B) shl 16) or (LongWord(A) shl 24); Inc(fxFixed,wxInc); end; PLongWord(DstRow)[DX+X]:=ChunkCubic[0]; PLongWord(DstRow)[DX+X+1]:=ChunkCubic[1]; PLongWord(DstRow)[DX+X+2]:=ChunkCubic[2]; PLongWord(DstRow)[DX+X+3]:=ChunkCubic[3]; X:=X+4; end; while X<ClipX1 do begin if fxFixed>=0 then begin IX0:=fxFixed div 256; wxI:=fxFixed and 255; end else begin IX0:=(fxFixed-255) div 256; wxI:=fxFixed-IX0*256; end; fxF:=wxI/256; wxW[0]:=CubicW(1+fxF); wxW[1]:=CubicW(fxF); wxW[2]:=CubicW(1-fxF); wxW[3]:=CubicW(2-fxF); rAcc:=0; gAcc:=0; bAcc:=0; aAcc:=0; for ky:=0 to 3 do begin SrcRow:=CubicRows[ky]; for kx:=0 to 3 do begin sxK:=IX0+kx-1; if sxK<0 then sxK:=0 else if sxK>=ASrc.Width then sxK:=ASrc.Width-1; sc:=PLongWord(SrcRow)[sxK]; rAcc:=rAcc+Byte(sc)*wxW[kx]*wyW[ky]; gAcc:=gAcc+Byte(sc shr 8)*wxW[kx]*wyW[ky]; bAcc:=bAcc+Byte(sc shr 16)*wxW[kx]*wyW[ky]; aAcc:=aAcc+Byte(sc shr 24)*wxW[kx]*wyW[ky]; end; end; if rAcc<0 then rAcc:=0 else if rAcc>255 then rAcc:=255; if gAcc<0 then gAcc:=0 else if gAcc>255 then gAcc:=255; if bAcc<0 then bAcc:=0 else if bAcc>255 then bAcc:=255; if aAcc<0 then aAcc:=0 else if aAcc>255 then aAcc:=255; R:=Byte(Round(rAcc)); G:=Byte(Round(gAcc)); B:=Byte(Round(bAcc)); A:=Byte(Round(aAcc)); PLongWord(DstRow)[DX+X]:=LongWord(R) or (LongWord(G) shl 8) or (LongWord(B) shl 16) or (LongWord(A) shl 24); Inc(fxFixed,wxInc); Inc(X); end; Inc(fyFixed,wyInc); end; end; end; end;
end.

