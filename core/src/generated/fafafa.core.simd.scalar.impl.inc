  i: SizeUInt;
begin
  if aCount = 0 then
    Exit;

  for i := 0 to aCount - 1 do
    if aSrc1[i] <= aSrc2[i] then
      aDst[i] := aSrc1[i]
    else
      aDst[i] := aSrc2[i];
