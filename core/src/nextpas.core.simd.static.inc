{
  nextpas.core.simd.static.inc

  Compile-time static dispatch macros for SIMD operations.

  Usage:
    {$DEFINE SIMD_STATIC_SSE2}
    {$I nextpas.core.simd.static.inc}

  This eliminates runtime dispatch overhead by directly calling
  backend-specific implementations at compile time.

  Supported backends:
    - SIMD_STATIC_SSE2: Force SSE2 backend
    - SIMD_STATIC_AVX2: Force AVX2 backend
    - SIMD_STATIC_AVX512: Force AVX-512 backend
    - SIMD_STATIC_NEON: Force NEON backend
    - SIMD_STATIC_SCALAR: Force scalar fallback

  Performance impact:
    - Eliminates ~15-20 cycles per call (atomic_load + function pointer)
    - Enables compiler inlining of SIMD operations
    - Zero runtime overhead for backend selection
}

{$IFDEF SIMD_STATIC_SSE2}
  {$DEFINE SIMD_STATIC_BACKEND}
  {$DEFINE SIMD_STATIC_HAS_SSE2}
{$ENDIF}

{$IFDEF SIMD_STATIC_AVX2}
  {$DEFINE SIMD_STATIC_BACKEND}
  {$DEFINE SIMD_STATIC_HAS_AVX2}
{$ENDIF}

{$IFDEF SIMD_STATIC_AVX512}
  {$DEFINE SIMD_STATIC_BACKEND}
  {$DEFINE SIMD_STATIC_HAS_AVX512}
{$ENDIF}

{$IFDEF SIMD_STATIC_NEON}
  {$DEFINE SIMD_STATIC_BACKEND}
  {$DEFINE SIMD_STATIC_HAS_NEON}
{$ENDIF}

{$IFDEF SIMD_STATIC_SCALAR}
  {$DEFINE SIMD_STATIC_BACKEND}
  {$DEFINE SIMD_STATIC_HAS_SCALAR}
{$ENDIF}

{
  Phase A: Compile-time validation for STATIC_BACKEND.

  If SIMD_STATIC_BACKEND is defined directly (without specifying a backend),
  emit a compile error guiding the user to use the correct defines.
}

{$IFDEF SIMD_STATIC_BACKEND}
  {$IF NOT DEFINED(SIMD_STATIC_HAS_SSE2) AND NOT DEFINED(SIMD_STATIC_HAS_AVX2) AND NOT DEFINED(SIMD_STATIC_HAS_AVX512) AND NOT DEFINED(SIMD_STATIC_HAS_NEON) AND NOT DEFINED(SIMD_STATIC_HAS_SCALAR)}
    {$ERROR SIMD_STATIC_BACKEND requires a specific backend: define SIMD_STATIC_SSE2, SIMD_STATIC_AVX2, SIMD_STATIC_AVX512, SIMD_STATIC_NEON, or SIMD_STATIC_SCALAR}
  {$ENDIF}
{$ENDIF}

{
  Static dispatch macros for vector operations.

  These macros replace the runtime dispatch with direct function calls.
  They are only available when a static backend is defined.
}

{$IFDEF SIMD_STATIC_BACKEND}

