{
  nextpas.core.settings.inc
  Global compiler settings for the nextpas.core framework.
  Include this file at the top of every unit.
}

{$mode objfpc}{$H+}
{$modeswitch advancedrecords}
{$modeswitch anonymousfunctions}
{$modeswitch functionreferences}

{$IFOPT O+}
  {$DEFINE NEXTPAS_CORE_INLINE}
{$ENDIF}

{$DEFINE NEXTPAS_CORE_ANONYMOUS_REFERENCES}
{$DEFINE NEXTPAS_CORE_CONTRACTS}

{ Temporary compatibility for copied modules not migrated yet. }
{$IFDEF NEXTPAS_CORE_INLINE}
  {$DEFINE FAFAFA_CORE_INLINE}
{$ENDIF}
{$IFDEF NEXTPAS_CORE_ANONYMOUS_REFERENCES}
  {$DEFINE FAFAFA_CORE_ANONYMOUS_REFERENCES}
{$ENDIF}
{$IFDEF NEXTPAS_CORE_CONTRACTS}
  {$DEFINE FAFAFA_CORE_CONTRACTS}
{$ENDIF}

{$IFDEF DEBUG}
  {$C+}
  {$R+}
  {$Q+}
  {$S+}
{$ENDIF}

{ Platform detection }
{$IF defined(NEXTPAS_FORCE_HOST_WINDOWS)}
  {$DEFINE NEXTPAS_WINDOWS}
{$ELSEIF defined(NEXTPAS_FORCE_HOST_ANDROID)}
  {$DEFINE NEXTPAS_ANDROID}
  {$DEFINE NEXTPAS_UNIX}
  {$DEFINE NEXTPAS_POSIX_CLOCK}
{$ELSEIF defined(NEXTPAS_FORCE_HOST_DARWIN)}
  {$DEFINE NEXTPAS_MACOS}
  {$DEFINE NEXTPAS_UNIX}
{$ELSEIF defined(NEXTPAS_FORCE_HOST_LINUX)}
  {$DEFINE NEXTPAS_LINUX}
  {$DEFINE NEXTPAS_UNIX}
  {$DEFINE NEXTPAS_POSIX_CLOCK}
{$ELSEIF defined(NEXTPAS_FORCE_HOST_FREEBSD)}
  {$DEFINE NEXTPAS_FREEBSD}
  {$DEFINE NEXTPAS_UNIX}
  {$DEFINE NEXTPAS_POSIX_CLOCK}
{$ELSEIF defined(NEXTPAS_FORCE_HOST_UNIX)}
  {$DEFINE NEXTPAS_UNIX}
  {$DEFINE NEXTPAS_POSIX_CLOCK}
{$ELSEIF defined(WINDOWS)}
  {$DEFINE NEXTPAS_WINDOWS}
{$ELSEIF defined(ANDROID)}
  {$DEFINE NEXTPAS_ANDROID}
  {$DEFINE NEXTPAS_UNIX}
  {$DEFINE NEXTPAS_POSIX_CLOCK}
{$ELSEIF defined(DARWIN)}
  {$DEFINE NEXTPAS_MACOS}
  {$DEFINE NEXTPAS_UNIX}
{$ELSEIF defined(LINUX)}
  {$DEFINE NEXTPAS_LINUX}
  {$DEFINE NEXTPAS_UNIX}
  {$DEFINE NEXTPAS_POSIX_CLOCK}
{$ELSEIF defined(FREEBSD)}
  {$DEFINE NEXTPAS_FREEBSD}
  {$DEFINE NEXTPAS_UNIX}
  {$DEFINE NEXTPAS_POSIX_CLOCK}
{$ELSEIF defined(UNIX)}
  {$DEFINE NEXTPAS_UNIX}
  {$DEFINE NEXTPAS_POSIX_CLOCK}
{$ENDIF}

{ CPU detection }
{$IF defined(CPUX86_64)}
  {$DEFINE NEXTPAS_X86_64}
{$ELSEIF defined(CPUAARCH64)}
  {$DEFINE NEXTPAS_AARCH64}
{$ELSEIF defined(CPURISCV64)}
  {$DEFINE NEXTPAS_RISCV64}
{$ELSEIF defined(CPUARM)}
  {$DEFINE NEXTPAS_ARM}
{$ENDIF}

{ === SIMD Framework Configuration === }

{$DEFINE SIMD_AGGRESSIVE_INLINE}
{$DEFINE SIMD_RUNTIME_DETECTION}

{$IFDEF DEBUG}
  {$DEFINE SIMD_DEBUG_ASSERTIONS}
  {$DEFINE SIMD_BOUNDS_CHECK}
{$ENDIF}

{ SIMD platform detection }
{$IFDEF NEXTPAS_X86_64}
  {$DEFINE SIMD_X86_64}
  {$DEFINE SIMD_LITTLE_ENDIAN}
{$ENDIF}
{$IFDEF CPUI386}
  {$DEFINE SIMD_X86_32}
  {$DEFINE SIMD_LITTLE_ENDIAN}
{$ENDIF}
{$IFDEF NEXTPAS_AARCH64}
  {$DEFINE SIMD_AARCH64}
  {$DEFINE SIMD_LITTLE_ENDIAN}
{$ENDIF}
{$IFDEF NEXTPAS_ARM}
  {$DEFINE SIMD_ARM32}
  {$DEFINE SIMD_LITTLE_ENDIAN}
{$ENDIF}

{ SIMD backend feature flags }
{$DEFINE SIMD_BACKEND_SCALAR}
{$IF DEFINED(SIMD_X86_64) OR DEFINED(SIMD_X86_32)}
  {$DEFINE SIMD_X86_AVAILABLE}
  {$DEFINE SIMD_BACKEND_SSE2}
  {$DEFINE SIMD_BACKEND_AVX2}
  {$DEFINE SIMD_BACKEND_AVX512}
{$ENDIF}
{$IF DEFINED(SIMD_AARCH64) OR DEFINED(SIMD_ARM32)}
  {$DEFINE SIMD_ARM_AVAILABLE}
  {$DEFINE SIMD_BACKEND_NEON}
{$ENDIF}
{$IFDEF NEXTPAS_RISCV64}
  {$DEFINE SIMD_RISCV64}
  {$DEFINE SIMD_RISCV_AVAILABLE}
  {$DEFINE SIMD_BACKEND_RISCVV}
{$ENDIF}

{$DEFINE SIMD_OPTIMIZE_SPEED}

{$IF DEFINED(SIMD_X86_AVAILABLE) OR DEFINED(SIMD_ARM_AVAILABLE)}
  {$DEFINE SIMD_HARDWARE_ACCELERATION}
{$ENDIF}
